<?xml version="1.0" encoding="utf-8"?>
<!-- #355: the non-cancelable waiting room for the Argon2id KDF runs.
     Indicator tokens are the #94 Tor bar's (v3_accent / md_grey_400 /
     4dp) so the overlay speaks the import screen's progress language.
     No secret material renders here, so the overlay window sets no
     FLAG_SECURE of its own and leaves the host window's flags alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/kdfProgressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/md_grey_100"
        android:textSize="16sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/kdfProgressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/v3_accent"
        app:trackColor="@color/md_grey_400"
        app:trackThickness="4dp" />

</LinearLayout>
