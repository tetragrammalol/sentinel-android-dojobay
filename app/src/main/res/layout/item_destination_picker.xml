<?xml version="1.0" encoding="utf-8"?>
<!-- #635: one own collection in the destination picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/destinationPickerRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/destinationPickerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="A collection" />

    <TextView
        android:id="@+id/destinationPickerBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        tools:text="0.01500000 BTC" />

    <!-- #646 leg 1: the path+index line, same figure the receive advanced view renders. -->
    <TextView
        android:id="@+id/destinationPickerPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/md_grey_500"
        tools:text="m/84'/0'/0'/0/24" />

    <!-- #654: off-network badge, the collections list's #429 shape
         (rvItemCollectionBadge). maxLines=2 + ellipsize=end: wrap or
         ellipsize, never clip. -->
    <TextView
        android:id="@+id/destinationPickerBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="gone" />

</LinearLayout>
