<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/explorerOptionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/explorerOptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explorerOptionSubline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/explorerOptionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9A9A9A"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/explorerOptionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explorer_option_needs_tor"
            android:textColor="#9A9A9A"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/explorerOptionSelected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/explorer_option_selected"
        android:src="@drawable/ic_baseline_check_24"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/explorerOptionInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/explorer_option_info"
        android:padding="12dp"
        android:src="@drawable/ic_info_outline" />

</LinearLayout>
