<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- #635: the return marker slot. QA #666 item 3: INVISIBLE, not
         GONE - the 16dp is reserved on every row, icon or not, so all
         rows share one geometry and none hugs the centerline. -->
    <ImageView
        android:id="@+id/txDiagramRowIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:visibility="invisible" />

    <!-- QA #666: 14sp -> 12sp, joining the compose/UTXO amount style. -->
    <TextView
        android:id="@+id/txDiagramRowName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:textSize="12sp" />

    <!-- #635 device QA: row names never yield width - the value column
         is the flexible side, so under masking only the asterisks can
         ever be cut. Names are never shortened, any mode. -->
    <TextView
        android:id="@+id/txDiagramRowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp" />

</LinearLayout>
