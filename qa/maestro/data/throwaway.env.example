# Template only. Generate the real file with:  python3 scripts/gen_throwaway.py   (writes data/throwaway.env)
# Every value is PUBLIC throwaway data from random, discarded seeds that are never funded.
# Never put a real wallet's keys or addresses here. data/*.env is git-ignored.
VPUB_A=<testnet BIP84 vpub, throwaway account A>
VPUB_B=<testnet BIP84 vpub, throwaway account B>
VPUB_C=<testnet BIP84 vpub, throwaway account C>
VPUB_D=<testnet BIP84 vpub, throwaway account D>
VPUB_A_ADDR0=<tb1q... first receive address of VPUB_A, m/0/0>
TPUB=<testnet BIP44 tpub>
UPUB=<testnet BIP49 upub>
XPUB_MAIN=<mainnet xpub (only used to check it is rejected on testnet)>
YPUB_MAIN=<mainnet ypub, same account>
ZPUB_MAIN=<mainnet zpub, same account>
TB1_ADDR=<tb1q... address of VPUB_D>
MAIN_ADDR=<bc1q... mainnet address (only used to check it is rejected on testnet)>
VPUB_TRUNC=<VPUB_A cut to 60 characters>
VPUB_BADSUM=<VPUB_A with its last character changed (bad checksum)>
TB1_BADSUM=<TB1_ADDR with its last character changed (bad checksum)>
GARBAGE=hello garbage not a key
